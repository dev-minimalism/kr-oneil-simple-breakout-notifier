# 윌리엄 오닐 돌파매매 봇 환경 설정
# 이 파일을 .env로 복사하고 실제 값으로 변경하세요

# ========================================
# 텔레그램 봇 설정 (필수)
# ========================================

# 텔레그램 봇 토큰 (@BotFather에서 받은 토큰)
TELEGRAM_TOKEN=your_bot_token_here

# 텔레그램 채팅 ID (@userinfobot에서 확인)
TELEGRAM_CHAT_ID=your_chat_id_here


# ========================================
# 스캔 설정
# ========================================

# 스캔 주기 (초 단위, 기본: 1800 = 30분)
SCAN_INTERVAL=1800


# ========================================
# 감시 종목 설정
# ========================================

# 한국 주식 종목 코드 (쉼표로 구분)
# 기본값: 삼성전자, SK하이닉스, NAVER, 카카오 등
KR_WATCH_LIST=005930,000660,035420,035720,373220,086520,247540,066970,068270,091990,207940,326030,005380,000270,051910,006400,096770,009540,010140


# ========================================
# 패턴 감지 설정
# ========================================

# 피벗 돌파
VOLUME_SURGE_MIN=50
BREAKOUT_MAX=5

# 컵앤핸들
CUP_DEPTH_MIN=12
CUP_DEPTH_MAX=40
HANDLE_DEPTH_MAX=12

# 베이스 돌파
BASE_VOLATILITY_MAX=15
BASE_VOLUME_SURGE_MIN=40
BASE_BREAKOUT_MAX=7


# ========================================
# 거래 설정
# ========================================

# 손절 기준 (%, 음수)
STOP_LOSS_PERCENT=-7.5

# 익절 기준 (%)
TAKE_PROFIT_PERCENT=20

# 최대 보유 기간 (일)
MAX_HOLDING_DAYS=30


# ========================================
# 데이터 설정
# ========================================

# 분석 기간 (일)
ANALYSIS_PERIOD_DAYS=120


# ========================================
# PostgreSQL 데이터베이스 설정 (SSH 터널)
# ========================================

# DB 사용 여부 (true/false, 기본: false - JSON 파일 사용)
USE_DATABASE=false

# SSH 터널 설정
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_KEY_PATH=~/.ssh/id_rsa
# SSH 서버 호스트 키 검증용 known_hosts (등록되지 않은 서버는 연결 거부)
# 등록: ssh-keyscan -p 22 your_ssh_host >> ~/.ssh/known_hosts
SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# PostgreSQL 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oneil_breakout
DB_USER=your_db_user
DB_PASSWORD=your_db_password